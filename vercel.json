{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/h/Album",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/h/about",
      "missing": [
        {
          "type": "query",
          "key": "cont"
        }
      ],
      "destination": "/about",
      "permanent": true
    }
  ],
  "installCommand": "npm ci"
}
